<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zifang</groupId>
        <artifactId>z-lc</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>z-lc-admin</artifactId>
    <name>z-lc-bootstrap</name>
    <description>z-lc 独立启动入口 (端到端验证用) — 跑 z-lc-web 全部 Controller + z-lc-design 全部 SPI, 不依赖
        main-starter / z-ctc / z-config.
    </description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- z-lc-web (含 LcModuleDataSource 数据源 + 全部 controller) -->
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-lc-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- z-lc-design (含 PageTemplateController + LowCodeModelService 收集器) -->
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-lc-design</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- z-lc-core 内部依赖传递到 admin: z-agent-llm-gateway-core (AiModelingService 用到) -->
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-agent-llm-gateway-core</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-lc-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-lc-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Web (provided 走 z-lc-web, 这里加保险) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Log4j2 (替代 spring-boot 默认 logback) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
            <exclusions>
                <!--
                    排除 spring-boot-starter-log4j2 自带的 log4j-slf4j-impl 2.17.x (跟 z-util-core 拉的 log4j-slf4j2-impl 2.26.x 双版本冲突,
                    NoSuchMethodError org.apache.logging.slf4j.Log4jLoggerFactory.<init>).
                    只保留新版 log4j-slf4j2-impl (slf4j-api 2.x + log4j-api 2.x + log4j-core 2.x 一套).
                -->
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- mysql-connector-j 显式引 (z-lc-core 引了但 runtime 阶段才加载, 显式保险) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- H2 v1.4.200 (默认 user=sa / password=空, dev 模式免密) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>1.4.200</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.zifang.z.lc.bootstrap.ZLcBootstrapApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
