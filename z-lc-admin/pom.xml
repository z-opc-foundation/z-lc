<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zifang</groupId>
        <artifactId>z-lc</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>z-lc-admin</artifactId>
    <name>z-lc-bootstrap</name>
    <description>z-lc 独立启动入口 (端到端验证用) — 跑 z-lc-web 全部 Controller + z-lc-design 全部 SPI, 不依赖
        main-starter / z-ctc / z-config.
    </description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            Log4j2 全套显式锁定到 2.20.0 + slf4j-api 2.0.7:
            修复 spring-boot-dependencies 2.7.12 强制降级 log4j-slf4j-impl 2.25.4 → 2.17.2 导致的
            NoSuchMethodError org.apache.logging.slf4j.Log4jLoggerFactory.<init>().
            (slf4j-api 2.x 与 log4j-slf4j-impl 2.20+ 配套; 2.17.x 是 slf4j-api 1.7 时代的产物, 不能混用.)
        -->
        <log4j2.version>2.20.0</log4j2.version>
        <slf4j.version>2.0.7</slf4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-slf4j-impl</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-jul</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- z-lc-web (含 LcModuleDataSource 数据源 + 全部 controller) -->
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-lc-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- z-lc-design (含 PageTemplateController + LowCodeModelService 收集器) -->
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-lc-design</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- z-lc-core 内部依赖传递到 admin: z-agent-llm-gateway-core (AiModelingService 用到) -->
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-agent-llm-gateway-core</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-lc-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-lc-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Web (provided 走 z-lc-web, 这里加保险) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Log4j2 (替代 spring-boot 默认 logback) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
            <exclusions>
                <!--
                    排除 spring-boot-starter-log4j2 自带的 log4j-slf4j-impl 2.17.x (跟 z-util-core 拉的 log4j-slf4j2-impl 2.26.x 双版本冲突,
                    NoSuchMethodError org.apache.logging.slf4j.Log4jLoggerFactory.<init>).
                    只保留新版 log4j-slf4j2-impl (slf4j-api 2.x + log4j-api 2.x + log4j-core 2.x 一套).
                -->
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- mysql-connector-j 显式引 (z-lc-core 引了但 runtime 阶段才加载, 显式保险) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- H2 2.2.224: 实测 MODE=MySQL 可直接执行本仓库的 MySQL DDL (含 ENGINE/UNIQUE KEY/内联 KEY),
             1.4.200 反而不支持 CASE_INSENSITIVE_IDENTIFIERS, 故锁 2.x -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.zifang.z.lc.bootstrap.ZLcBootstrapApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
