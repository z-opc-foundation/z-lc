<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-lc</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>z-lc-admin</artifactId>
    <name>z-lc-bootstrap</name>
    <description>z-lc 独立启动入口 (端到端验证用) — 跑 z-lc-web 全部 Controller + z-lc-design 全部 SPI, 不依赖
        main-starter / z-ctc / z-config.
    </description>

    <properties>
        <!--
            Log4j2 全套显式锁定到 2.20.0 + slf4j-api 2.0.7:
            修复 spring-boot-dependencies 2.7.12 强制降级 log4j-slf4j-impl 2.25.4 → 2.17.2 导致的
            NoSuchMethodError org.apache.logging.slf4j.Log4jLoggerFactory.<init>().
            (slf4j-api 2.x 与 log4j-slf4j-impl 2.20+ 配套; 2.17.x 是 slf4j-api 1.7 时代的产物, 不能混用.)
        -->
        <log4j2.version>2.20.0</log4j2.version>
        <slf4j.version>2.0.7</slf4j.version>
    </properties>

    <dependencyManagement>
        <!-- 这一块**整块逐字保留**（README「消费模型」步骤 1/3 的"刻意分歧"）：
             log4j2 一族 2.20.0 + slf4j-api 2.0.7 是修 NoSuchMethodError
             (org.apache.logging.slf4j.Log4jLoggerFactory.<init>) 的既有决定，面值就靠这些
             **模块侧直接条目**顶住：直接条目按"最近声明"赢过继承来的父链 DM（floor:1.0.19 把
             log4j-api/core/jul/slf4j-impl 直钉 2.25.4、Boot BOM 把 slf4j-api 给 1.7.36）。
             preflight 迁前把 log4j2.version 报成"与父链不同值 2.20.0 vs 2.25.4"、slf4j.version
             报成"父链不供这个键名"，两条都在这一层原地解决，没有删键、也没有把键上抬到根 pom
             （上抬会让 z-lc-core/-design/-web 那三棵树也跟着换实现，那是另一件事）。 -->
        <dependencies>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-slf4j-impl</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-jul</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 下面几处自家依赖都不写版本（z-boot README「消费模型」步骤 3 / trap 3：模块侧写版本压过
             一切 DM）：4 个自家模块由根 pom 的 dependencyManagement 钉 project.version，
             z-llm-core 由继承来的 parent（fleet 面值）供。迁移那一轮这里删掉的是
             z-agent-llm-gateway-core 那条字面 1.0.0-SNAPSHOT —— 2026-09-30 那条坐标整体退役，
             换成交手面 z-llm-core（见下面那条注释）。
             本模块的 maven.compiler.source/target/encoding 那三格也删了（父链供 8/8/UTF-8 同值）。 -->
        <!-- z-lc-web (含 LcModuleDataSource 数据源 + 全部 controller) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-web</artifactId>
        </dependency>
        <!-- z-lc-design (含 PageTemplateController + LowCodeModelService 收集器) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-design</artifactId>
        </dependency>
        <!-- z-lc-core 内部依赖传递到 admin: z-llm-core（AiModelingService 的方法签名要用）。
             原来这一格是 com.zifang:z-agent-llm-gateway-core，那条构件 repo1 两个 namespace 均 404、
             组织里源码也已不存在 ⇒ 换到接手面 io.github.yuku123:z-llm-core（判据见根 pom）。
             刻意只引 core、不引 z-llm-starter：AiModelingService 那个字段是
             @Autowired(required=false) + Qualifier("zLlmChatGatewayService")，而 starter 的自动装配
             没进来时它就是 null ⇒ 走模板 fallback。这与迁前的实际运行形状一致（迁前 admin 也只引
             core，qualifier 指的是 zAgentLlmGatewayLlmGatewayService，同样没有 bean 供它）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-llm-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-common</artifactId>
        </dependency>

        <!-- Spring Boot Web (provided 走 z-lc-web, 这里加保险) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Log4j2 (替代 spring-boot 默认 logback) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
            <exclusions>
                <!--
                    排除 spring-boot-starter-log4j2 自带的 log4j-slf4j-impl 2.17.x (跟 z-util-core 拉的 log4j-slf4j2-impl 2.26.x 双版本冲突,
                    NoSuchMethodError org.apache.logging.slf4j.Log4jLoggerFactory.<init>).
                    只保留新版 log4j-slf4j2-impl (slf4j-api 2.x + log4j-api 2.x + log4j-core 2.x 一套).
                -->
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- mysql-connector-j 显式引 (z-lc-core 引了但 runtime 阶段才加载, 显式保险) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- H2 2.2.224: 实测 MODE=MySQL 可直接执行本仓库的 MySQL DDL (含 ENGINE/UNIQUE KEY/内联 KEY),
             1.4.200 反而不支持 CASE_INSENSITIVE_IDENTIFIERS, 故锁 2.x
             ⚠ 这一处字面 <version> 在迁移里**故意留着不删**：基线树里 h2 是两格共存
             （z-lc-core / z-lc-web 的 test 作用域走 Boot/floor 的 2.1.214，本模块 runtime 走 2.2.224）。
             删掉这一行 → 本模块静默降到 2.1.214（上面那段 DDL 支持就是它写下来的理由）；
             把它上抬成根 DM 的直接条目 → z-lc-core/-web 两棵树静默升到 2.2.224。
             两个方向都是本次迁移没被授权做的实现更换，所以维持"模块侧最近声明"原样；已记入迁移报告的
             "拒绝裁定"（h2 到底统一成哪一格、由谁统一，是 z-lc 自己的功能决定，不是消费模型决定）。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 2026-10-01 补的 test 域: 让 z-lc-admin 自己有测试能力, 不依赖 z-lc-common 把 DevMainDataSourceConfigTest 等覆盖上来.
             junit-jupiter 版本由 z-lc 根 pom 的 junit BOM (5.9.3) 顶住. -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.zifang.z.lc.bootstrap.ZLcBootstrapApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
