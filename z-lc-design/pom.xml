<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-lc</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>z-lc-design</artifactId>

    <!-- 迁移改动（逐条同值，判据见根 pom 的 properties / DM 注释）：
         · 那块 <properties>（maven.compiler.source/target + sourceEncoding）删了，父链同值供给。
         · knife4j-openapi3-spring-boot-starter 的字面 <version>4.1.0</version> 删了：地板按同一坐标
           直钉 ${knife4j-openapi3.version}=4.1.0（现读 repo1 z-boot-dependencies-1.0.19.pom:295-296），
           与基线树 knife4j-*:jar:4.1.0 逐字相同 ⇒ 上面那句"不显式 version"这次才真正成立。
         · z-util-core 的 ${util.version} 删了：fleet 同坐标直钉 1.0.13，同值。
         · 本模块自己排掉 spring-boot-starter-logging / logback-classic 的三条 exclusion 是建仓就有的
           写法（floor 的 *:* 通配 exclusion 对本模块是惰性的，运行期实现仍是 log4j2）。 -->
    <name>z-lc-design</name>
    <description>z-lc Design Framework — @LowCodeModel / @LowCodeModelService / PageTemplate / Collector. Framework
        core, no business implementation.
    </description>

    <dependencies>
        <!-- Log4j2 API (本模块 src/main/java 含 LogManager.getLogger 调用) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-common</artifactId>
        </dependency>

        <!-- z-lc-design 需要 web (Controller) + spring-context (Collector 扫注解) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!-- Swagger 3.x 注解 (@Tag / @Operation) — 走 z-boot 管理的 knife4j-openapi3, 不显式 version -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>

        <!-- 本模块测试源码是 JUnit 4（org.junit.Test）。此前靠旧 com.zifang:z-util-core:1.0.2-SNAPSHOT
             泄漏的 compile 作用域 junit 编过；1.0.13 换回 io.github.yuku123 坐标后显式声明。 -->
    </dependencies>
</project>
