<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.apache.org/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-lc</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>z-lc-report-web</artifactId>
    <packaging>jar</packaging>
    <name>z-lc :: report-web (REST API: 数据源/数据集/渲染/Book)</name>
    <description>
        端到端链路: 注册数据源 → 注册数据集 → 预览/渲染 → Book 编排与发布。
        M1 内存态存储; 接口契约与 M2 落库后保持一致。
    </description>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-report-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-report-dataset</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-report-datasource</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-report-render</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-report-book</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-report-ai</artifactId>
        </dependency>
        <!-- z-boot 体系: web 能力一行 import -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-web-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
