<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zifang</groupId>
        <artifactId>z-opc</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>z-lc</artifactId>
    <packaging>pom</packaging>

    <name>z-lc</name>
    <description>z-lc Low-Code Platform — Phase 1: DB-driven Generic CRUD Engine</description>

    <modules>
        <module>z-lc-common</module>
        <module>z-lc-sdk</module>
        <module>z-lc-core</module>
        <module>z-lc-design</module>
        <module>z-lc-web</module>
        <!-- z-lc-admin: standalone 启动入口, 端到端验证用 (dev profile 走 H2, 零外部依赖).
             生产集成仍走 main-starter, 此处恢复 build 以便独立跑通全链路. -->
        <module>z-lc-admin</module>
    </modules>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <compile.version>8</compile.version>
        <!-- z-util 抬到 1.0.12: 数据源注册/探活/方言/动态查询/内存 SQL 引擎收口在 z-util-jdbc,
             本仓不再自建造池代码 (父 pom z-opc 的 util.version 仍是 1.0.9, 其它仓不受影响) -->
        <util.version>1.0.12</util.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 对齐 z-meta:z-boot 依赖管理 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-dependencies</artifactId>
                <version>1.0.16</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-web-starter</artifactId>
                <version>1.0.16</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-datasource-starter</artifactId>
                <version>1.0.16</version>
            </dependency>

            <!-- z-lc 内部模块版本 -->
            <dependency>
                <groupId>com.zifang</groupId>
                <artifactId>z-lc-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zifang</groupId>
                <artifactId>z-lc-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zifang</groupId>
                <artifactId>z-lc-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zifang</groupId>
                <artifactId>z-lc-design</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zifang</groupId>
                <artifactId>z-lc-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- z-lc-spring-boot-starter 已迁移至 z-boot/z-boot-integration-starters -->
            <dependency>
                <groupId>com.zifang</groupId>
                <artifactId>z-lc-admin</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 对象整形语言 (二维分组结果 → 任意高维结构): 已安装的 z-opc BOM 里还没有这一条
                 (它只列了 el/groovy/lua/sql/js), 所以在此显式给版本, 跟着 util.version 一起抬 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-util-expr-obj</artifactId>
                <version>${util.version}</version>
            </dependency>

            <!-- 三个数据源依赖统一走 z-boot-datasource-starter（见上方 dependencyManagement 中的 z-boot-datasource-starter） -->

            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
                <version>4.1.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>2.7.12</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${compile.version}</source>
                    <target>${compile.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
