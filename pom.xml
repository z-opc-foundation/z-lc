                    地板按同一坐标直钉 ${knife4j-openapi3.version}=4.1.0（现读 repo1
                    z-boot-dependencies-1.0.19.pom:295-296），与迁移前逐字同值 ⇒ 删条目，并把
                    z-lc-design / z-lc-web 两处字面 <version>4.1.0</version>（trap 3）一起删，
                    两侧 tree 都是 4.1.0（同 z-meta/pom.xml:202-205）。
                 5) io.github.yuku123:z-util-expr-obj:${util.version} 的直接条目：fleet 按同一坐标供
                    1.0.13，与 ${util.version} 面值同值 ⇒ 键与条目一起删，改由 fleet 下发
                    （基线树 io.github.yuku123:z-util-expr-obj:jar:1.0.13，迁后一样）。
                 6) 三个数据源依赖统一走 z-boot-datasource-starter（这句原注释保留原意：
                    依赖口径没变，只是 starter 的版本改由 parent 下发）。 -->
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <!-- 这一格**逐字保留 2.7.12、不动**（同 z-ext/pom.xml:164-178、z-meta/pom.xml:210-221）：
                         parent 的 pluginManagement 下发的是 ${spring-boot.version}=2.7.18，而本仓这一格是
                         迁移前就盖在父链前面的字面量；删掉它等于把 z-lc-web / z-lc-admin 的 repackage
                         插件从 2.7.12 抬到 2.7.18（fat jar 的 loader 与打包形状跟着变），那是插件换版，
                         不是"统一继承 parent"这一刀要顺手做的事。子 pom 的 pluginManagement 压过继承来的，
                         留着就是零漂移。 -->
                    <version>2.7.12</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- maven-compiler-plugin 那一块（3.11.0 + source/target ${compile.version}）删掉了：
                 parent 的 pluginManagement 供同一个 3.11.0（现读 maven-compiler-plugin.version=3.11.0，
                 与迁移前字面量逐字相同）+ source/target 8 + UTF-8 + `-parameters`，本仓不再自己起炉灶
                 （同 z-ext/pom.xml:181-183、z-task/pom.xml:155-157）。键 ${compile.version} 的唯一引用点
                 就是这一块，同一次提交里一起删（trap 4）。 -->

            <!-- 发布形状（z-boot README「消费模型」步骤 7）：z-boot-parent 那条 flatten 声明是
                 <inherited>false</inherited> + resolveCiFriendliesOnly（现读 repo1
                 z-boot-parent-1.0.19.pom 的 <build><plugins> 只有 flatten-maven-plugin 一件，
                 inherited=false），**不下发**给消费仓 ⇒ 加了 <parent> 之后本仓必须自己把 pom 扁平掉，
                 否则发出去的是带着 org parent 链的 raw pom。
                 判据按本仓中央上现有形状：repo1 实测 io.github.yuku123 与 com.zifang 两个 namespace 下
                 z-lc / z-lc-common / z-lc-core 的 maven-metadata.xml 全部 404（本仓从未对外发布过），
                 而迁移前那份根 pom 唯一的 <parent> 就是 com.zifang:z-opc:1.0.0-SNAPSHOT 那个幻影件
                 ——照原样发出去，任何外部消费者第一次解析就报 Could not find artifact
                 com.zifang:z-opc:pom:1.0.0-SNAPSHOT，构件全废 ⇒ 按 z-cache/z-ext/z-meta 口径发**自包含**
                 的 pom（flatten oss + updatePomFile）。真正对外发什么形状由全组织那一批定，记入"拒绝裁定"。
                 常开而不是挂 central profile：不带 -P central 的 mvn install 会把带着 z-boot-parent 的
                 废 pom 装进仓里。版本写字面量 1.5.0：门禁机 250（Maven 3.6.0）实测只有 1.5.0 rc=0，
                 1.6.0/1.7.x 要求 Maven 3.6.3+（parent 自己那格是 1.7.3，它发的是 z-boot 仓，不是这里）。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.5.0</version>
                <inherited>true</inherited>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- ═══════ 中央发布通道（2026-09-30 CEO 裁定「上到中央仓库」）═══════
         逐件抄 z-cache/pom.xml 的 central profile，插件版本面值一件不改：
         distributionManagement 指 https://central.sonatype.com（server id central 的凭据只在
         ~/.m2/settings.xml，值不落仓）；maven-deploy-plugin 3.1.4 skip=true，上传由
         central-publishing-maven-plugin 0.7.0 接管（tokenAuth + autoPublish + waitUntil=uploaded）；
         maven-source-plugin 3.3.0、maven-javadoc-plugin 3.11.2（doclint=none + failOnError=false）、
         maven-gpg-plugin 3.2.7（passphrase 只从 -Dgpg.passphrase 传，不写进 pom 也不写进命令行历史）。
         发布用 pom 的自包含由上面常开的 flatten(oss) + updatePomFile 负责。 -->
    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>3.1.4</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                            <!-- Java 口径由 parent 的 pluginManagement 下发（z-cache 这里原先引的是
                                 本仓没定义过的 compile.version，配 failOnError=false 后静默变成无效参数） -->
                            <source>${maven.compiler.source}</source>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--no-tty</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <!-- 本插件不认 maven.deploy.skip，没排除的模块照样进 bundle
                                 （实测结论见 z-schedule/pom.xml 同位置注释）⇒ 不可发布的模块点名列出。
                                  · z-lc-admin：repackage 指定 mainClass ZLcBootstrapApplication ⇒ 产物是 standalone 端到端入口的 fat jar，不是库件
                                  -->
                            <excludeArtifacts>
                                <excludeArtifact>z-lc-admin</excludeArtifact>
                            </excludeArtifacts>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 真发前的形状检查：同一套 distributionManagement，只跳 javadoc 与签名。
             与 central 一起开（-Pcentral,central-dryrun）时后者的 properties 覆盖 skip 两格。 -->
        <profile>
            <id>central-dryrun</id>
            <properties>
                <maven.javadoc.skip>true</maven.javadoc.skip>
                <central.gpg.skip>true</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
    </profiles>
</project>