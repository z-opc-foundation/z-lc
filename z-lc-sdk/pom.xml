<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zifang</groupId>
        <artifactId>z-lc</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>z-lc-sdk</artifactId>
    <name>z-lc-sdk</name>
    <description>z-lc SPI Framework — 25 SPI interfaces, annotations and abstract base. Pure API, no business
        implementation.
    </description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Log4j2 API (本模块 src/main/java 含 LogManager.getLogger 调用) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <!-- z-lc-sdk 引用 z-lc-common (DTO) + z-meta-common (Result/PageResult) -->
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-lc-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
            <version>${util.version}</version>
        </dependency>

        <!-- 纯 API — 只引 spring-core (注解扫描), 不引 lombok (手写 getter/setter) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
        </dependency>
        <!-- spring-context (ApplicationContextAware / AnnotatedElementUtils — TaskServiceCollector 用) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- Jackson databind (InnerDataModelServiceAdapter 反射 POJO ↔ Map 转换用) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- 本模块测试源码是 JUnit 4（org.junit.Test）。此前编译能过，是因为旧
             com.zifang:z-util-core:1.0.2-SNAPSHOT 的 pom 把 junit 漏成了 compile 作用域；
             1.0.13 换回 io.github.yuku123 坐标后必须自己显式声明（版本由 spring-boot-dependencies 管）。 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
