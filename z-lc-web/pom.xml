<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-lc</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>z-lc-web</artifactId>

    <name>z-lc-web</name>
    <description>低代码平台 Web 层：控制器、数据源健康探测与 spring.factories 自动配置注册，供宿主 embed；本模块的 spring-boot-maven-plugin 没有 repackage execution，入库的是普通 library jar</description>

    <!-- 迁移改动（逐条同值或有明确归属，判据见根 pom 的 properties / DM 注释）：
         · 那块 <properties>（maven.compiler.source/target + sourceEncoding）删了，父链同值供给。
         · 三处 <version> 删了：knife4j-openapi3-spring-boot-starter 4.1.0（地板同值 4.1.0）、
           z-boot-datasource-starter 1.0.17（parent 下发 1.0.19，同 z-lc-core 那一处）、
           z-agent-llm-gateway-core ${project.version}（收进根 DM 同坐标同值，仍是 test 作用域）。
         · z-util-core / z-util-expr-obj 无版本，由 fleet 下发 1.0.13，与基线树同值。
         · 自家 4 个 sibling 依赖本来就不写版本，走根 DM 的 ${project.version}。 -->

    <dependencies>
        <!-- Log4j2 API (本模块 src/main/java 含 LogManager.getLogger 调用) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <!-- Spring Web 但排除 Logback (z-opc 强制 Log4j2) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Log4j2 (z-opc 标准日志) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!-- z-lc 内部依赖 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-lc-design</artifactId>
        </dependency>

        <!-- z-util-core (PageResult) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>

        <!-- 对象整形语言: /runtime/shape 把聚合出的二维行抬成任意高维结构 (版本由父 pom 管理) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-expr-obj</artifactId>
        </dependency>

        <!-- API 文档 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
        </dependency>

        <!-- 数据源 starter (ModuleDataSourceTemplate / Druid) — 替代 mybatis-plus -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-datasource-starter</artifactId>
        </dependency>

        <!-- 测试: Spring Boot Test (JUnit5 + MockMvc + AssertJ + Jackson) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 测试: H2 (MODE=MySQL) 内存库, 跑真实 MetaController 契约 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            z-lc-core 把 io.github.yuku123:z-llm-core 声明成 optional, 所以它不会传递进来.
            AiModelingService 是 core.ai 包下的 @Component 且方法签名引用了 ChatGatewayService,
            LcAutoConfiguration 整包扫 core 之后, 缺这个类会让上下文 introspect 直接失败
            (NoClassDefFoundError: ChatGatewayService). 生产 standalone 由 z-lc-admin 显式引;
            这里补齐 test scope 让集成测试能起上下文.
            坐标 2026-09-30 从 com.zifang:z-agent-llm-gateway-core 换过来（那条只在 ~/.m2、
            repo1 两个 namespace 均 404，组织里也没有它的源码了），理由与类集判据见根 pom 那条注释。
        -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-llm-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
